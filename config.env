# Hostile Input :: shared settings for every triage script.
#
# Edit this once and every script picks it up. An environment variable set on the
# command line still wins: MODEL=gemma4:12b ./triage.sh f.pdf works, because these
# assignments are guarded. There are no --api / --model flags by design.
# Run ./smoke.sh to find the right address for your setup.

# Where the model runs. It is on your HOST, not in the VM.
#   VirtualBox NAT : http://10.0.2.2:11434
#   UTM / VMware   : http://192.168.64.1:11434
#   No VM at all   : http://localhost:11434
OLLAMA_HOST="${OLLAMA_HOST:-http://127.0.0.1:11434}"

# Apple Silicon: pull gemma4:e4b-mlx, then  ollama cp gemma4:e4b-mlx gemma4:e4b
# so this name works everywhere.
MODEL="${MODEL:-gemma4:e4b}"
